# No actual credentials. Use a separate, ignored .env.production.local with absolute paths.
COMPOSE_PROJECT_NAME=caicang-production
RELEASE_TAG=replace-with-verified-git-commit
SITE_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com
SECRETS_DIR=/srv/caicang-secrets
POSTGRES_DB=caicang
# Do not open public signups until email ownership/onboarding has been reviewed.
PUBLIC_REGISTRATION_ENABLED=false
# Safe default: local-only. Public binding requires explicit deployment approval.
PUBLIC_BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
PROXY_SUBNET=172.30.35.0/29
PROXY_IP=172.30.35.2
API_PROXY_IP=172.30.35.3
