# FOR LOCAL DEVELOPMENT ONLY: do not commit .env
NODE_ENV=development
# pnpm db:up generates a random local password when .env does not exist.
# For an existing volume, changing this value does not change the DB role password.
POSTGRES_PASSWORD=replace-with-long-random-local-password
DATABASE_URL=postgresql://caicang:replace-with-long-random-local-password@localhost:5432/caicang?schema=public
# Reserved for the later authentication task; unused by current health API.
JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-different-long-random-secret
API_PORT=3000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173,http://localhost:5174
# true/false only. Production requires HTTPS WEB_ORIGIN and SWAGGER_ENABLED=false.
SWAGGER_ENABLED=true
RATE_LIMIT_LIMIT=120
RATE_LIMIT_TTL_MS=60000
API_BODY_LIMIT_KB=64
# Empty means no forwarded IP headers are trusted. Only explicit IP/CIDR lists are allowed.
TRUSTED_PROXIES=
